<mujoco model="prism_device">
  <compiler angle="degree" coordinate="local" meshdir="../assets/"/>
  <option gravity="0 0 -9.81"/>

  <default>
    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" rgba="0.78 0.78 0.8 1"/>
    </default>
    <default class="collision">
      <geom type="mesh" density="1200" rgba="0.2 0.2 0.2 0.08"/>
    </default>
  </default>

  <asset>
    <mesh name="prism_top" file="Top.stl" scale="0.001 0.001 0.001"/>
    <mesh name="prism_bottom" file="Bottom.stl" scale="0.001 0.001 0.001"/>
    <mesh name="prism_shaft_mesh" file="Shaft.stl" scale="0.001 0.001 0.001"/>
    <mesh name="blue_handle_hub" file="blue_handle/gobuilda_rex_hub.stl" scale="0.0254 0.0254 0.0254"/>
    <mesh name="blue_handle_inner" file="blue_handle/handle_inner_bare_metal.stl" scale="0.0254 0.0254 0.0254"/>
    <mesh name="blue_handle_outer" file="blue_handle/handle_outer_blue.stl" scale="0.0254 0.0254 0.0254"/>
  </asset>

  <worldbody>
    <geom name="floor" type="plane" size="2 2 0.1" pos="0 0 0" rgba="0.95 0.95 0.95 1"/>

    <body name="world_axes" pos="0 0 0.0005">
      <geom name="world_x_axis" type="capsule" fromto="0 0 0 0.006 0 0" size="0.00012" rgba="1 0 0 1" contype="0" conaffinity="0" group="4"/>
      <geom name="world_y_axis" type="capsule" fromto="0 0 0 0 0.006 0" size="0.00012" rgba="0 1 0 1" contype="0" conaffinity="0" group="4"/>
      <geom name="world_z_axis" type="capsule" fromto="0 0 0 0 0 0.006" size="0.00012" rgba="0 0 1 1" contype="0" conaffinity="0" group="4"/>
      <site name="world_origin" pos="0 0 0" size="0.00025" rgba="1 1 0 1" group="4"/>
    </body>

    <body name="prism_mount" pos="0 0 0" quat="1 0 0 0">
      <site name="prism_frame_origin" pos="0 0 0" size="0.0002" rgba="0 1 1 1" group="4"/>
      <geom name="prism_x_axis" type="capsule" fromto="0 0 0 0.004 0 0" size="0.00009" rgba="1 0.4 0.4 1" contype="0" conaffinity="0" group="4"/>
      <geom name="prism_y_axis" type="capsule" fromto="0 0 0 0 0.004 0" size="0.00009" rgba="0.4 1 0.4 1" contype="0" conaffinity="0" group="4"/>
      <geom name="prism_z_axis" type="capsule" fromto="0 0 0 0 0 0.004" size="0.00009" rgba="0.4 0.4 1 1" contype="0" conaffinity="0" group="4"/>

      <body name="prism_base">
        <geom name="top_visual" class="visual" mesh="prism_top" rgba="0.50 0.56 0.24 1"/>
        <geom name="bottom_visual" class="visual" mesh="prism_bottom" rgba="0.50 0.56 0.24 1"/>
        <geom name="top_collision" class="collision" mesh="prism_top"/>
        <geom name="bottom_collision" class="collision" mesh="prism_bottom"/>

        <body name="prism_shaft" pos="0 0 0.08">
          <joint name="prism_joint" type="hinge" axis="0 0 1" pos="0 0 0" damping="0.0" frictionloss="0.0"/>
          <geom name="shaft_visual" class="visual" mesh="prism_shaft_mesh" quat="0.70710678 0.70710678 0 0" rgba="0.85 0.65 0.25 1"/>
          <geom name="shaft_collision" class="collision" mesh="prism_shaft_mesh" quat="0.70710678 0.70710678 0 0"/>
          <site name="prism_shaft_axis_origin" pos="0 0 0" size="0.003" rgba="1 0 0 1"/>

          <body name="blue_handle" pos="0 0 0.025">
            <geom name="blue_handle_hub_visual" class="visual" mesh="blue_handle_hub" quat="0.70710678 0.70710678 0 0"/>
            <geom name="blue_handle_inner_visual" class="visual" mesh="blue_handle_inner" quat="0.70710678 0.70710678 0 0"/>
            <geom name="blue_handle_outer_visual" class="visual" mesh="blue_handle_outer" quat="0.70710678 0.70710678 0 0" rgba="0.10 0.35 0.95 1"/>
            <geom name="blue_handle_hub_collision" class="collision" mesh="blue_handle_hub" quat="0.70710678 0.70710678 0 0"/>
            <geom name="blue_handle_inner_collision" class="collision" mesh="blue_handle_inner" quat="0.70710678 0.70710678 0 0"/>
            <geom name="blue_handle_outer_collision" class="collision" mesh="blue_handle_outer" quat="0.70710678 0.70710678 0 0"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <general name="prism_motor" joint="prism_joint" ctrlrange="-10 10"/>
  </actuator>
</mujoco>
